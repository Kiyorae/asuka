<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Matcha.App.LogConsoleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Matcha.App">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Background="Transparent" DefaultLabelPosition="Right">
            <AppBarButton x:Name="CopySelectedButton" Label="Copy selected">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CopyFilteredButton" Label="Copy filtered">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8B0;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ExportButton" Label="Export">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="ClearButton" Label="Clear activity">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" Margin="16,4,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search logs"
                PlaceholderText="Search summary or payload" />
            <ComboBox
                x:Name="CategoryBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Filter activity category"
                SelectedIndex="0">
                <x:String>All activity</x:String>
                <x:String>Application logs</x:String>
                <x:String>Protocol traffic</x:String>
                <x:String>Connection only</x:String>
                <x:String>Errors only</x:String>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360" />
                <ColumnDefinition Width="3*" MinWidth="380" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="LogList"
                Margin="12,0,6,12"
                AutomationProperties.Name="Activity entries"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="3,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="14" Glyph="{Binding Glyph}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Opacity="0.65"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Header}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border
                Grid.Column="1"
                Margin="6,0,12,12"
                Padding="14"
                Style="{StaticResource MatchaCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailHeader" FontSize="17" FontWeight="SemiBold" Text="Select a log entry" />
                    <TextBox
                        x:Name="DetailBox"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Log entry detail"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap"
                        />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Padding="16,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="0 entries" />
            <InfoBar
                x:Name="ErrorInfoBar"
                HorizontalAlignment="Right"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</Window>
