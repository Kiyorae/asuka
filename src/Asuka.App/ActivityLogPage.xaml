<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Asuka.App.ActivityLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Asuka.App">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Background="Transparent" DefaultLabelPosition="Right">
            <AppBarButton x:Name="CopySelectedButton" Label="Copy selected">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CopyFilteredButton" Label="Copy filtered">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8B0;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ExportButton" Label="Export">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="ClearButton" Label="Clear activity">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1" Margin="16,4,16,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search logs"
                PlaceholderText="Search summary or payload" />
            <ComboBox
                x:Name="CategoryBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Filter activity category"
                SelectedIndex="0">
                <x:String>All activity</x:String>
                <x:String>Application logs</x:String>
                <x:String>Protocol traffic</x:String>
                <x:String>Connection only</x:String>
                <x:String>Errors only</x:String>
            </ComboBox>
        </Grid>

        <Grid
            x:Name="LogContentGrid"
            Grid.Row="2"
            ColumnSpacing="12"
            RowSpacing="12">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="NarrowLogLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="EntriesColumn.Width" Value="*" />
                            <Setter Target="DetailsColumn.Width" Value="0" />
                            <Setter Target="EntriesRow.Height" Value="2*" />
                            <Setter Target="DetailsRow.Height" Value="3*" />
                            <Setter Target="LogList.(Grid.Row)" Value="0" />
                            <Setter Target="LogList.(Grid.Column)" Value="0" />
                            <Setter Target="LogList.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="LogList.Margin" Value="12,0,12,0" />
                            <Setter Target="DetailCard.(Grid.Row)" Value="1" />
                            <Setter Target="DetailCard.(Grid.Column)" Value="0" />
                            <Setter Target="DetailCard.(Grid.ColumnSpan)" Value="2" />
                            <Setter Target="DetailCard.Margin" Value="12,0,12,12" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideLogLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="920" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="EntriesColumn.Width" Value="2*" />
                            <Setter Target="DetailsColumn.Width" Value="3*" />
                            <Setter Target="EntriesRow.Height" Value="*" />
                            <Setter Target="DetailsRow.Height" Value="0" />
                            <Setter Target="LogList.(Grid.Row)" Value="0" />
                            <Setter Target="LogList.(Grid.Column)" Value="0" />
                            <Setter Target="LogList.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="LogList.Margin" Value="12,0,0,12" />
                            <Setter Target="DetailCard.(Grid.Row)" Value="0" />
                            <Setter Target="DetailCard.(Grid.Column)" Value="1" />
                            <Setter Target="DetailCard.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="DetailCard.Margin" Value="0,0,12,12" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="EntriesRow" Height="*" />
                <RowDefinition x:Name="DetailsRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EntriesColumn" Width="2*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="3*" />
            </Grid.ColumnDefinitions>
            <ListView
                x:Name="LogList"
                Margin="12,0,0,12"
                AutomationProperties.Name="Activity entries"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="3,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="14" Glyph="{Binding Glyph}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Opacity="0.65"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Header}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border
                x:Name="DetailCard"
                Grid.Column="1"
                Margin="0,0,12,12"
                Padding="14"
                Style="{StaticResource AsukaCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailHeader" FontSize="17" FontWeight="SemiBold" Text="Select a log entry" />
                    <TextBox
                        x:Name="DetailBox"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Log entry detail"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextWrapping="NoWrap" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Padding="16,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="0 entries" />
            <InfoBar
                x:Name="ErrorInfoBar"
                HorizontalAlignment="Right"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</UserControl>
