<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Asuka.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Asuka.App">

    <Grid x:Name="RootGrid" Padding="28,8,28,20" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideSettingsLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowSettingsLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ProtocolSecondaryColumn.Width" Value="0" />
                        <Setter Target="ProtocolSecondRow.Height" Value="Auto" />
                        <Setter Target="TransportBox.(Grid.Column)" Value="0" />
                        <Setter Target="TransportBox.(Grid.Row)" Value="1" />

                        <Setter Target="HostSecondaryColumn.Width" Value="0" />
                        <Setter Target="HostSecondRow.Height" Value="Auto" />
                        <Setter Target="PortBox.(Grid.Column)" Value="0" />
                        <Setter Target="PortBox.(Grid.Row)" Value="1" />

                        <Setter Target="EventSecondColumn.Width" Value="0" />
                        <Setter Target="EventThirdColumn.Width" Value="0" />
                        <Setter Target="EventSecondRow.Height" Value="Auto" />
                        <Setter Target="EventThirdRow.Height" Value="Auto" />
                        <Setter Target="ReconnectBox.(Grid.Column)" Value="0" />
                        <Setter Target="ReconnectBox.(Grid.Row)" Value="1" />
                        <Setter Target="SelfEventsSwitch.(Grid.Column)" Value="0" />
                        <Setter Target="SelfEventsSwitch.(Grid.Row)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="SettingsEditor"
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <StackPanel
                MaxWidth="880"
                Padding="0,0,12,16"
                HorizontalAlignment="Stretch"
                Spacing="28">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Demo" />
                    <Border Padding="20" Style="{StaticResource AsukaCardStyle}">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="DemoModeSwitch" Header="Demo mode" OnContent="On" OffContent="Off" />
                            <TextBlock
                                Text="Play a slow stream of rich messages in a fixed group and private chat, including the logo and animated images. Demo conversations use separate local data."
                                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DemoModeHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Connection" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose the protocol endpoint and connection behaviour."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Padding="20" Style="{StaticResource AsukaCardStyle}">
                        <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ProtocolPrimaryColumn" Width="*" />
                                <ColumnDefinition x:Name="ProtocolSecondaryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="ProtocolSecondRow" Height="0" />
                            </Grid.RowDefinitions>
                            <ComboBox
                                x:Name="ProtocolBox"
                                Header="Protocol"
                                HorizontalAlignment="Stretch" />
                            <ComboBox
                                x:Name="TransportBox"
                                Grid.Column="1"
                                Header="Transport"
                                HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HostPrimaryColumn" Width="3*" />
                                <ColumnDefinition x:Name="HostSecondaryColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="HostSecondRow" Height="0" />
                            </Grid.RowDefinitions>
                            <TextBox
                                x:Name="HostBox"
                                Header="Host"
                                PlaceholderText="127.0.0.1" />
                            <NumberBox
                                x:Name="PortBox"
                                Grid.Column="1"
                                Header="Port"
                                Minimum="1"
                                Maximum="65535"
                                SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <TextBox
                            x:Name="PathBox"
                            Header="WebSocket path"
                            PlaceholderText="Use the protocol default" />
                        <TextBox
                            x:Name="AdvertisedHostBox"
                            Header="Advertised host"
                            PlaceholderText="Optional host used in generated media URLs" />
                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontSize="15"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE774;" />
                                <TextBlock
                                    x:Name="EndpointPreview"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Authentication &amp; events" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Secure the endpoint and control reconnect and event delivery behaviour."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Padding="20" Style="{StaticResource AsukaCardStyle}">
                        <StackPanel Spacing="16">
                        <PasswordBox
                            x:Name="TokenBox"
                            Header="Access token"
                            PasswordRevealMode="Peek"
                            PlaceholderText="Stored in Windows Credential Locker" />
                        <TextBox
                            x:Name="WebhookBox"
                            MinHeight="76"
                            AcceptsReturn="True"
                            Header="Milky WebHook URLs"
                            PlaceholderText="One HTTP or HTTPS URL per line"
                            TextWrapping="NoWrap" />
                        <TextBox x:Name="OneBotWebhookBox" MinHeight="76" AcceptsReturn="True"
                            Header="OneBot WebHook URLs" PlaceholderText="One HTTP or HTTPS URL per line"
                            TextWrapping="NoWrap" Visibility="Collapsed" />
                        <PasswordBox x:Name="WebhookSecretBox" Header="WebHook signing secret"
                            PasswordRevealMode="Peek" PlaceholderText="Stored in Windows Credential Locker"
                            Visibility="Collapsed" />
                        <NumberBox x:Name="WebhookTimeoutBox" Header="WebHook timeout (ms, 0 = no timeout)"
                            Minimum="0" Maximum="4294967294" SpinButtonPlacementMode="Compact" Visibility="Collapsed" />
                        <ToggleSwitch x:Name="HeartbeatSwitch" Header="Heartbeat events" Visibility="Collapsed" />
                        <NumberBox x:Name="HeartbeatIntervalBox" Header="Heartbeat interval (ms)" Minimum="1"
                            Maximum="2147483647" SpinButtonPlacementMode="Compact" Visibility="Collapsed" />
                        <NumberBox x:Name="RateLimitBox" Header="Rate limit interval (ms)" Minimum="0" Maximum="3600000" SpinButtonPlacementMode="Compact" Visibility="Collapsed" />
                        <ToggleSwitch x:Name="HttpEventsSwitch" Header="HTTP event polling" OnContent="Enabled" OffContent="Disabled" Visibility="Collapsed" />
                        <NumberBox x:Name="HttpEventBufferBox" Header="Event buffer size (0 = unlimited)" Minimum="0" Maximum="2147483647" SpinButtonPlacementMode="Compact" Visibility="Collapsed" />
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="EventSecondColumn" Width="*" />
                                <ColumnDefinition x:Name="EventThirdColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="EventSecondRow" Height="0" />
                                <RowDefinition x:Name="EventThirdRow" Height="0" />
                            </Grid.RowDefinitions>
                            <ToggleSwitch x:Name="ReconnectSwitch" Header="Auto reconnect" />
                            <NumberBox
                                x:Name="ReconnectBox"
                                Grid.Column="1"
                                Header="Delay (seconds)"
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Compact" />
                            <ToggleSwitch
                                x:Name="SelfEventsSwitch"
                                Grid.Column="2"
                                Header="Post bot-generated events" />
                        </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Identity &amp; appearance" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="The sending identity authors simulated messages. The bot account owns the protocol session and conversation self ID."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Padding="20" Style="{StaticResource AsukaCardStyle}">
                        <StackPanel Spacing="16">
                        <ComboBox
                            x:Name="ActivePersonaBox"
                            Header="Sending identity"
                            DisplayMemberPath="Description"
                            HorizontalAlignment="Stretch" />
                        <ComboBox
                            x:Name="BotPersonaBox"
                            Header="Bot account / protocol self ID"
                            DisplayMemberPath="Description"
                            HorizontalAlignment="Stretch" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <ComboBox x:Name="ThemeBox" Header="App theme" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="About" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Application information and local storage."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Padding="20" Style="{StaticResource AsukaCardStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="AboutLogoButton"
                                Width="72"
                                Height="72"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Asuka app icon"
                                Background="Transparent"
                                BorderThickness="0">
                                <Grid x:Name="AboutLogoMotionHost" Width="72" Height="72">
                                    <Image
                                        Source="ms-appx:///Assets/Akame.png"
                                        Stretch="Uniform"
                                        AutomationProperties.Name="Asuka app icon" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" Spacing="9">
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="Asuka for Windows" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Native WinUI 3 · .NET 10 · Windows 11" TextWrapping="Wrap" />
                                <TextBlock
                                    MaxWidth="680"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="A local protocol simulator and conversation workspace. Rendering, networking, storage, dialogs, file access, and credentials use Windows and Microsoft .NET APIs—no browser engine is embedded."
                                    TextWrapping="Wrap" />
                                <HyperlinkButton
                                    x:Name="OpenDataFolderButton"
                                    Margin="-12,0,0,0"
                                    HorizontalAlignment="Left"
                                    Content="Open data folder" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="20" Style="{StaticResource AsukaCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Components and licenses" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Asuka uses the following runtime and bundled native components. Open each project’s license for its complete terms."
                                TextWrapping="Wrap" />
                            <ItemsControl x:Name="ComponentLicensesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ComponentLicense">
                                        <Grid ColumnSpacing="12" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind LicenseName}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <HyperlinkButton
                                                Grid.Column="1"
                                                Content="License"
                                                NavigateUri="{x:Bind LicenseUri}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar
                x:Name="ValidationInfoBar"
                VerticalAlignment="Center"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="Settings couldn't be saved" />
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button x:Name="ResetButton" Content="Reset" />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
