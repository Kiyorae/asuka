<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Asuka.App.ProtocolInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16,18,16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Margin="0,0,40,0" Spacing="2">
                <TextBlock Text="Protocol inspector" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Requests, responses &amp; events" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="CloseButton" Width="32" Height="32" Padding="0" HorizontalAlignment="Right"
                    Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="Close protocol inspector"
                    ToolTipService.ToolTip="Close protocol inspector">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
        <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search action, message, ID or JSON"
                 AutomationProperties.Name="Search protocol requests and events" />
        <StackPanel Grid.Row="2" Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="TypeBox" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Protocol entry type">
                    <x:String>All types</x:String><x:String>Requests</x:String><x:String>Responses</x:String><x:String>Events</x:String>
                </ComboBox>
                <ComboBox x:Name="ProtocolBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Protocol filter">
                    <x:String>All protocols</x:String><x:String>OneBot V11</x:String><x:String>OneBot V12</x:String><x:String>Milky</x:String>
                </ComboBox>
            </Grid>
            <CheckBox x:Name="ErrorsOnlyBox" Content="Errors only" MinHeight="28" />
        </StackPanel>
        <Grid Grid.Row="3">
            <ListView x:Name="EntryList" SelectionMode="Single" AutomationProperties.Name="Protocol requests and events">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,7" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Metadata}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="12">
                <FontIcon Glyph="&#xE9CE;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EmptyTitle" Text="No protocol traffic yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyDescription" Text="Connect a bot to inspect its requests and events."
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="MoreButton" Content="Show more" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" />
        </Grid>
        <Grid Grid.Row="5" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel Margin="0,0,40,0" Spacing="2">
                    <TextBlock x:Name="DetailTitle" Text="Payload" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailMetadata" Text="Select an entry to inspect its JSON"
                               Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="CopyButton" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" IsEnabled="False"
                        AutomationProperties.Name="Copy protocol payload" ToolTipService.ToolTip="Copy JSON" Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
            </Grid>
            <TextBox x:Name="DetailBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Protocol request or event JSON" />
        </Grid>
    </Grid>
</UserControl>
