<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Asuka.App.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="Transparent" Opacity="0">
        <Grid.Resources>
            <Storyboard x:Name="EntranceStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28" />
                <DoubleAnimation Storyboard.TargetName="SplashTransform" Storyboard.TargetProperty="ScaleX" From="0.94" To="1" Duration="0:0:0.42" EnableDependentAnimation="True" />
                <DoubleAnimation Storyboard.TargetName="SplashTransform" Storyboard.TargetProperty="ScaleY" From="0.94" To="1" Duration="0:0:0.42" EnableDependentAnimation="True" />
                <DoubleAnimation Storyboard.TargetName="SplashTransform" Storyboard.TargetProperty="TranslateY" From="16" To="0" Duration="0:0:0.42" EnableDependentAnimation="True" />
            </Storyboard>
            <Storyboard x:Name="ExitStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
            </Storyboard>
        </Grid.Resources>

        <Border
            Margin="1"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="15">
            <Grid x:Name="SplashContent" Width="420" Height="300" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="SplashTransform" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    Width="154"
                    Height="154"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Asuka"
                    Source="ms-appx:///Assets/Akame.png"
                    Stretch="Uniform" />

                <StackPanel Grid.Row="1" Margin="32,0,32,30" Spacing="7">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="Asuka" />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16" Height="16" IsActive="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="正在准备原生工作区" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
